PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# Set to an exact comma-separated list of trusted app origins when hosted.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=10

# Add provider keys only to server/.env. Never put them in Flutter or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Adzuna job-search API credentials; keep these on the server.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Preferred order is task-specific; unavailable providers are skipped.
AI_ORDER_WRITING=anthropic,openai,gemini,groq
AI_ORDER_STRUCTURED=openai,gemini,anthropic,groq

# Optional LinkedIn OpenID Connect app credentials. Profile fields are limited
# to what the approved LinkedIn product/scopes return; skills/history may not.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/linkedin/callback
